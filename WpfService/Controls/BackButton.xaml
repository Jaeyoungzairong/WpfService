<UserControl x:Class="WpfService.Controls.BackButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">

    <dx:SimpleButton Background="Transparent"
                     BorderThickness="0"
                     Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Arrow3Left.svg'}"
                     GlyphWidth="32" GlyphHeight="32"
                     Width="60" Height="40"
                     Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}">

        <dx:WpfSvgPalette.Palette>
            <dx:WpfSvgPalette OverridesThemeColors="True">
                <SolidColorBrush x:Key="Yellow" Color="DimGray"/>
            </dx:WpfSvgPalette>
        </dx:WpfSvgPalette.Palette>
    </dx:SimpleButton>
</UserControl>
