<UserControl x:Class="WpfService.Views.LoadingIndicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">

    <Grid Background="#66000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <!-- 66(알파) = 약 40% 투명, 00 00 00 = 검정 -->

        <!-- 가운데 흰 박스 --><!--
        <Border CornerRadius="8"
                Background="White"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.4"
                                  ShadowDepth="3"
                                  BlurRadius="8"
                                  Direction="270"/>
            </Border.Effect>

        </Border>-->

        <dx:WaitIndicator
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="{Binding LoadingText}"
            DeferedVisibility="{Binding IsLoading}"
            FontSize="16">
            <dx:WaitIndicator.LayoutTransform>
                <ScaleTransform ScaleX="2.0" ScaleY="2.0"/>
            </dx:WaitIndicator.LayoutTransform>
        </dx:WaitIndicator>
    </Grid>
</UserControl>