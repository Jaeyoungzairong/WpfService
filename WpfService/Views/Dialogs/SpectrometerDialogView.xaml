<UserControl x:Class="WpfService.Views.Dialogs.SpectrometerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             Height="350" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Read Count"
                   FontSize="16"/>

        <dxe:SpinEdit Grid.Row="0" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      MinValue="1" MaxValue="30" Increment="1"
                      IsFloatValue="False"
                      EditValue="{Binding ReadCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Read Time"
                   FontSize="16"/>

        <dxe:SpinEdit Grid.Row="1" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      MinValue="6" MaxValue="100" Increment="1"
                      Mask="d"
                      EditValue="{Binding ReadTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Position"
                   FontSize="16"/>

        <dxe:ComboBoxEdit Grid.Row="2" Grid.Column="1"
                          Margin="8"
                          FontFamily="Roboto"
                          FontSize="18"
                          ItemsSource="{Binding StepOptions}"
                          DisplayMember="Name"
                          ValueMember="Value"
                          IsTextEditable="False"
                          EditValue="{Binding Step}"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>


        <TextBlock Grid.Row="3" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Xenon"
                   FontSize="16"/>

        <dxe:SpinEdit Grid.Row="3" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      MinValue="0.1" MaxValue="1.0" Increment="0.1"
                      MaskType="Numeric"
                      Mask="p0"
                      MaskUseAsDisplayFormat="True"
                      IsFloatValue="True"
                      EditValue="{Binding Xenon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Optic Switch"
                   FontSize="16"/>

        <dxe:ComboBoxEdit Grid.Row="4" Grid.Column="1"
                          Margin="8"
                          FontFamily="Roboto"
                          FontSize="18"
                          ItemsSource="{Binding OpticOptions}"
                          IsTextEditable="False"
                          EditValue="{Binding Optic}"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>


