<UserControl x:Class="WpfService.Views.Dialogs.PasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             Height="150" Width="450">

    <Grid Margin="8" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <dx:DXImage Grid.Column="0"
                    Margin="8"
                    Source="{dx:DXImage 'SvgImages/Icon Builder/Security_Lock.svg'}"/>

        <dxe:PasswordBoxEdit Grid.Column="1"
                             Margin="8"
                             FontFamily="Roboto"
                             FontSize="24"
                             HorizontalContentAlignment="Center"
                             NullText="Password"
                             EditValue="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

    <!--<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
        
        --><!--<dxe:PasswordBoxEdit
            Margin="16"      
            FontFamily="Roboto"       
            FontSize="24"   
            
            HorizontalContentAlignment="Center"
            EditValue="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>--><!--

    </StackPanel>-->

</UserControl>

