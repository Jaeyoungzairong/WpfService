<Application x:Class="WpfService.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:vd="clr-namespace:WpfService.Views.Dialogs"
             xmlns:vmd="clr-namespace:WpfService.ViewModels.Dialogs" 
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type dx:SimpleButton}">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type dx:SimpleButton}">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--<Style TargetType="dx:DXMessageBox">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
        </Style>-->

        <Style TargetType="{x:Type dx:ThemedMessageBoxWindow}">
            <Setter Property="FontFamily" Value="Pretendard"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="MinHeight" Value="200"/>

            <!--<Style.Resources>
                <Style TargetType="dx:ThemedWindowDialogButton">
                    <Setter Property="MinWidth" Value="120"/>
                    <Setter Property="MinHeight" Value="36"/>
                    <Setter Property="FontFamily" Value="Roboto"/>
                    <Setter Property="FontSize" Value="18"/>
                </Style>
            </Style.Resources>-->
        </Style>

        <DataTemplate DataType="{x:Type vmd:PasswordDialogViewModel}">
            <vd:PasswordDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:SpectrometerDialogViewModel}">
            <vd:SpectrometerDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:NetworkDialogViewModel}">
            <vd:NetworkDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:InformationDialogViewModel}">
            <vd:InformationDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:DnaInputDialogViewModel}">
            <vd:DnaInputDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:UvInputDialogViewModel}">
            <vd:UvInputDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:CuvetteInputDialogViewModel}">
            <vd:CuvetteInputDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:EndExperimentDialogViewModel}">
            <vd:EndExperimentDialogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmd:ParameterDialogViewModel}">
            <vd:ParameterDialogView />
        </DataTemplate>

    </Application.Resources>
</Application>
