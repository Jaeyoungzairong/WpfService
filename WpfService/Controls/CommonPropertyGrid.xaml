    <UserControl.Resources>
        <DataTemplate x:Key="BoolCellTemplate">
            <dxe:CheckEdit
                IsChecked="{Binding Value, Mode=TwoWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <dxe:CheckEdit.LayoutTransform>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </dxe:CheckEdit.LayoutTransform>
            </dxe:CheckEdit>
        </DataTemplate>
    </UserControl.Resources>

    <dxprg:PropertyGridControl
        x:Name="propertyGrid"
        ShowProperties="WithPropertyDefinitions"
        ShowMenuButtonInRows="False"
        ExpandCategoriesWhenSelectedObjectChanged="True"
        SelectedObject="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType=UserControl}}" />
</UserControl>