<UserControl x:Class="WpfService.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:ctrl="clr-namespace:WpfService.Controls" 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1024">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand 
            EventName="Loaded"
            Command="{Binding LoadCommand}"/>
    </dxmvvm:Interaction.Behaviors>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
            <ctrl:BackButton Command="{Binding BackCommand}"/>
            
            <TextBlock
                Margin="16,0"
                Text="Recovery"
                FontFamily="Roboto"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

            <ctrl:ClockControl 
                DockPanel.Dock="Right" Margin="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=dx:ThemedWindow}}"
                Panel.ZIndex="999"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="8" LastChildFill="False">
            <TextBlock
                Margin="8,0"
                Text="Port"
                VerticalAlignment="Center"
                FontSize="18"
                />
            
            <dxe:ComboBoxEdit
                Margin="8,0"
                Width="150" Height="40"
                HorizontalContentAlignment="Center"
                FontSize="18"
                IsTextEditable="False"
                ItemsSource="{Binding PortItem}"
                IsEnabled="{Binding IsRunning, Converter={dxmvvm:BooleanNegationConverter}}"
                EditValue="{Binding SelectedPort}">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:EventToCommand EventName="PopupOpening"  Command="{Binding RefreshCommand}" />
                </dxmvvm:Interaction.Behaviors>
            </dxe:ComboBoxEdit>
            
            <dx:SimpleButton
                FontSize="16"
                FontFamily="Roboto"         
                Content="START"
                Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Next.svg'}" 
                GlyphToContentOffset="10"
                IsEnabled="{Binding IsRunning, Converter={dxmvvm:BooleanNegationConverter}}"
                Command="{Binding RecoveryCommand}"/>

            <dx:SimpleButton 
                DockPanel.Dock="Right"
                Width="60"
                Background="Transparent"
                BorderThickness="0"
                Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Settings.svg'}" 
                IsEnabled="{Binding IsRunning, Converter={dxmvvm:BooleanNegationConverter}}"
                Command="{Binding SettingCommand}"/>

            <dxe:CheckEdit
                DockPanel.Dock="Right"
                Margin="8,0"
                Content="Debug"
                EditValue="{Binding IsDebug}">
                <dxe:CheckEdit.LayoutTransform>
                    <ScaleTransform ScaleX="1.7" ScaleY="1.7"/>
                </dxe:CheckEdit.LayoutTransform>
            </dxe:CheckEdit>

        </DockPanel>

        <TextBox Grid.Row="2"
                 FontFamily="Roboto"
                 FontSize="16"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding LogText}"
                 TextChanged="LogTextBox_TextChanged"/>

        <ctrl:LoadingIndicator 
            Grid.Row="1"
            Grid.RowSpan="2"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    </Grid>
    
    
</UserControl>
