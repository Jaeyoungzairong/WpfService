<UserControl x:Class="WpfService.Views.Dialogs.InformationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:ctrl="clr-namespace:WpfService.Controls" 
             Height="380" Width="450">
    
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand 
            EventName="Loaded"
            Command="{Binding LoadCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--<StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="8">
            
            <Image Width="24" Height="24" Margin="8,0"
                   Source="{dx:DXImage 'SvgImages/XAF/Action_AboutInfo.svg'}"/>
            <TextBlock Text="Information"
                       FontFamily="Roboto"
                       FontWeight="Bold"
                       FontSize="18"/>
        </StackPanel>-->

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="User"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="0" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding User}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Host URL"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="1" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding Host}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Serial Number"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="2" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="{Binding IsReadOnly}"
                      EditValue="{Binding SerialNumber}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="S/W Ver."
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="3" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding VersionSW}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="F/W Ver."
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="4" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding VersionFW}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Spectrometer SN"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="5" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding SpectrometerSN}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Spectrometer PN"
                   FontSize="16"
                   Visibility="Hidden"/>

        <dxe:TextEdit Grid.Row="6" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      EditValue="{Binding SpectrometerPN}"
                      Visibility="Hidden"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="7" Grid.Column="1"
                   Margin="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Text="{Binding Version}"
                   FontSize="16"/>

        <ctrl:LoadingIndicator 
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            Grid.RowSpan="7"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
