<UserControl x:Class="WpfService.Views.Dialogs.NetworkDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             Height="350" Width="400">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand 
            EventName="Loaded"
            Command="{Binding LoadCommand}"/>
    </dxmvvm:Interaction.Behaviors>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Host"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="0" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="False"
                      EditValue="{Binding HostAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Port"
                   FontSize="16"/>

        <dxe:TextEdit Grid.Row="1" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="True"
                      MaskType="Numeric" Mask="d0"  MaskUseAsDisplayFormat="True"
                      EditValue="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Name"
                   FontSize="16"/>

        <dxe:ComboBoxEdit Grid.Row="2" Grid.Column="1"
                          Margin="8"
                          FontSize="18"
                          FontFamily="Roboto"
                          HorizontalContentAlignment="Center"
                          ItemsSource="{Binding NetworkNames}"
                          SelectedItem="{Binding SelectedNetworkName}"
                          IsTextEditable="False"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Mode"
                   FontSize="16"
                   Visibility="{Binding IsEthernet, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <dxe:ComboBoxEdit Grid.Row="3" Grid.Column="1"
                          Margin="8"
                          FontSize="18"
                          FontFamily="Roboto"
                          HorizontalContentAlignment="Center"
                          ItemsSource="{Binding AddressModes}"
                          SelectedItem="{Binding SelectedAddressMode}"
                          IsTextEditable="False"
                          Visibility="{Binding IsEthernet, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Local"
                   FontSize="16"
                   Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <dxe:TextEdit Grid.Row="4" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      NullText="192.168.1.102"
                      ShowNullTextIfFocused ="True"
                      EditValue="{Binding LocalAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Netmask"
                   FontSize="16"
                   Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <dxe:TextEdit Grid.Row="5" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      IsReadOnly="False"
                      NullText="255.255.255.0"
                      EditValue="{Binding Netmask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Gateway"
                   FontSize="16"
                   Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <dxe:TextEdit Grid.Row="6" Grid.Column="1"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      NullText="192.168.1.1"
                      ShowNullTextIfFocused ="True"
                      EditValue="{Binding Gateway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      Visibility="{Binding IsStatic, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
