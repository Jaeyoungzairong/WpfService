<UserControl x:Class="WpfService.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:ctrl="clr-namespace:WpfService.Controls" 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1024">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand 
            EventName="Loaded"
            Command="{Binding LoadCommand}"/>
    </dxmvvm:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </Grid.Resources>

        <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
            <ctrl:BackButton
                Command="{Binding BackCommand}"/>
            <TextBlock
                Margin="16,0"
                Text="Log"
                FontFamily="Roboto"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"/>
            <dx:SimpleButton
                DockPanel.Dock="Right"
                Glyph="{dx:DXImage 'SvgImages/Export/Export.svg'}"       
                FontSize="16"        
                FontFamily="Roboto"         
                Content="Download"
                Command="{Binding DownloadCommand}"/>
            <dxe:ComboBoxEdit 
                DockPanel.Dock="Right"
                Margin="8,0"
                Width="180" Height="40"
                HorizontalContentAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                IsTextEditable="False"
                ItemsSource="{Binding DateList}"
                EditValue="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <dx:DXImage 
                DockPanel.Dock="Right"
                Width="34"
                Height="34"
                Source="{dx:DXImage 'SvgImages/Icon Builder/Actions_Calendar.svg'}" />
        </DockPanel>

        <TextBox Grid.Row="1"
                 FontFamily="Roboto"
                 FontSize="16"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding LogText}"/>

        <ctrl:LoadingIndicator 
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
