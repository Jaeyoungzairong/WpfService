<UserControl x:Class="WpfService.Views.DeviceView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:ctrl="clr-namespace:WpfService.Controls" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:WpfService.ViewModels"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1024">

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand 
            EventName="Loaded"
            Command="{Binding LoadCommand}"/>
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <Style x:Key="TitleTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </Grid.Resources>

        <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
            <ctrl:BackButton 
                DockPanel.Dock="Left"
                Command="{Binding BackCommand}"/>
            <TextBlock
                DockPanel.Dock="Left"
                Margin="16,0"
                Text="Device"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Rows="2" Columns="4" Margin="8">

            <StackPanel>
                <TextBlock 
                    Text="Motor" 
                    Style="{StaticResource TitleTextStyle}"/>

                <dxe:ComboBoxEdit 
                    Margin="8,4"
                    Height="40"        
                    HorizontalContentAlignment="Center"        
                    FontSize="18"        
                    FontWeight="Bold"        
                    IsTextEditable="False" 
                    ItemsSource="{Binding}"
                    EditValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:EnumItemsSourceBehavior 
                            EnumType="{x:Type vm:MoveMode}"/>
                    </dxmvvm:Interaction.Behaviors>
                </dxe:ComboBoxEdit>

                <dxe:SpinEdit
                    Margin="8,4"
                    Height="40" 
                    FontFamily="Roboto"
                    FontSize="18"
                    MinValue="0" MaxValue="1000" Increment="100"
                    IsFloatValue="False"
                    IsEnabled="{Binding IsMoveValueEnabled}"
                    EditValue="{Binding MoveValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <TextBlock 
                    Height="40"
                    FontSize="16"
                    Margin="8,4"
                    HorizontalAlignment="Right" 
                    Text="{Binding MoveText}"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Move"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding MoveCommand}"/>
            </StackPanel>
            
            <StackPanel>
                <TextBlock 
                    Text="Optic Switch" 
                    Style="{StaticResource TitleTextStyle}"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Pedestal"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpticCommand}"
                    CommandParameter="Pedestal"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Cuvette"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding OpticCommand}"
                    CommandParameter="Cuvette"/>
            </StackPanel>

            <StackPanel>
                <TextBlock 
                    Text="Xenon(%)" 
                    Style="{StaticResource TitleTextStyle}"/>

                <dxe:TextEdit 
                    Margin="8,4"
                    Height="40"
                    FontFamily="Roboto"
                    FontSize="18"
                    MaskType="Numeric" Mask="d0"  MaskUseAsDisplayFormat="True"
                    EditValue="{Binding Xenon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Load"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding XenonCommand}"
                    CommandParameter="Load"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Save"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding XenonCommand}"
                    CommandParameter="Save"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Test"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding XenonCommand}"
                    CommandParameter="Test"/>
            </StackPanel>

            <StackPanel>
                <TextBlock 
                    Text="Temperature" 
                    Style="{StaticResource TitleTextStyle}"/>

                <dxe:SpinEdit
                    Margin="8,4"
                    Height="40" 
                    FontFamily="Roboto"
                    FontSize="18"
                    MinValue="0.0" MaxValue="50.0" Increment="0.1"
                    MaskType="Numeric" Mask="f1"
                    EditValue="{Binding Heating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <TextBlock 
                    Text="{Binding Temperature}"
                    FontSize="16"
                    Height="40"
                    Margin="8,4"
                    HorizontalAlignment="Right"/>

                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Set"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding TemperatureCommand}"
                    CommandParameter="Set"/>
                <dx:SimpleButton 
                    Margin="8,4"       
                    FontSize="16"     
                    Height="40"           
                    Content="Read"   
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding TemperatureCommand}"
                    CommandParameter="Read"/>
            </StackPanel>

        </UniformGrid>
        <ctrl:LoadingIndicator 
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="999"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>

</UserControl>
