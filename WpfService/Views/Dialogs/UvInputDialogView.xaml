<UserControl x:Class="WpfService.Views.Dialogs.UvInputDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             Height="200" Width="450">

    <Grid Margin="8" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Factor Type"
                   FontSize="16"/>

        <dxe:ComboBoxEdit Grid.Row="0" Grid.Column="1"
                          Margin="8"
                          IsReadOnly="{Binding IsReadOnly}"
                          FontFamily="Roboto"
                          FontSize="18"
                          ItemsSource="{Binding Factors}"
                          DisplayMember="Key"
                          ValueMember="Value"
                          SelectedItem="{Binding SelectedFactor}"
                          IsTextEditable="False"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Custom Factor (0.01 ~ 99.99)"
                   FontSize="16"
                   Visibility="{Binding IsCustomFactor, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>

        <dxe:SpinEdit Grid.Row="1" Grid.Column="1"
                      Margin="8"
                      IsReadOnly="{Binding IsReadOnly}"
                      IsEnabled="{Binding IsCustomFactor}"
                      FontFamily="Roboto"
                      FontSize="18"
                      MinValue="0.01" MaxValue="99.99"
                      Mask="f2"
                      AllowDefaultButton="False"
                      EditValue="{Binding Factor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

    </Grid>
</UserControl>

