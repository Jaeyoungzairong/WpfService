<UserControl x:Class="WpfService.Views.Dialogs.DnaInputDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" 
             Height="200" Width="450">

    <Grid Margin="8" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Margin="8"
                   VerticalAlignment="Center"
                   Text="Custom Factor (0.01 ~ 99.99)"
                   FontSize="16"/>

        <dxe:SpinEdit Grid.Row="0" Grid.Column="1"
                      IsReadOnly="{Binding IsReadOnly}"
                      Margin="8"
                      FontFamily="Roboto"
                      FontSize="18"
                      MinValue="0.01" MaxValue="99.99"
                      Mask="f2"
                      AllowDefaultButton="False"
                      EditValue="{Binding CustomFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
    </Grid>
</UserControl>
